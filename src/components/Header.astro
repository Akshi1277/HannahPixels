---
const navLinks = [
  { label: 'Home', to: '/' },
  { label: 'Capabilities', to: '/capabilities' },
  { label: 'Process', to: '/process' },
  { label: 'About', to: '/about' },
  { label: 'Contact', to: '/contact' },
]

const path = Astro.url.pathname
const isActive = (to: string) => (to === '/' ? path === '/' : path.startsWith(to))
const isHome = path === '/'
---

<header
  id="site-header"
  data-blend={isHome ? 'true' : 'false'}
  data-scrolled={isHome ? 'false' : 'true'}
  class="fixed top-0 left-0 right-0 z-40 transition-[background-color,border-color] duration-500 border-b border-transparent data-[scrolled=true]:bg-background/95 data-[scrolled=true]:backdrop-blur-sm data-[scrolled=true]:border-grid"
>
  <div class="max-w-[1440px] mx-auto px-6 lg:px-10 h-[76px] flex items-center justify-between gap-6">
    <a href="/" class="shrink-0 relative" aria-label="Hannah Pixels homepage">
      <img src="/hannahpixels-white.png" alt="Hannah Pixels" class="logo-white block h-8 w-auto object-contain" />
      <img src="/hannahpixels-dark.png" alt="" aria-hidden="true" class="logo-dark absolute inset-0 h-8 w-auto object-contain" />
    </a>

    <nav class="hidden md:flex items-center gap-9" aria-label="Main navigation">
      {navLinks.map((link) => (
        <a
          href={link.to}
          class="type-label transition-colors duration-500 nav-link"
          data-active={isActive(link.to) ? 'true' : 'false'}
          aria-current={isActive(link.to) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <a
      href="/contact"
      id="nav-cta"
      class="hidden md:inline-flex items-center type-label bg-ink text-ink-foreground hover:bg-accent-ink px-5 py-2.5"
    >
      Start a Project
    </a>

    <button
      id="menu-toggle"
      class="md:hidden flex items-center justify-center w-11 h-11 border transition-colors duration-500 nav-toggle"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <span class="relative block w-4 h-3" aria-hidden="true">
        <span class="menu-bar absolute left-0 top-0 w-4 h-px transition-transform"></span>
        <span class="menu-bar absolute left-0 bottom-0 w-4 h-px transition-transform"></span>
      </span>
    </button>
  </div>
</header>

<div
  id="mobile-menu"
  class="fixed inset-0 z-50 bg-background flex flex-col px-6 pt-[76px] pb-10 translate-x-full transition-transform duration-500 ease-[cubic-bezier(.16,1,.3,1)] md:hidden"
>
  <nav class="flex flex-col gap-1 pt-12" aria-label="Mobile navigation">
    {navLinks.map((link, i) => (
      <a
        href={link.to}
        class="mobile-nav-link font-serif text-5xl leading-[1.35] text-foreground hover:text-accent"
        style={`transition-delay: ${i * 40}ms`}
      >
        {link.label}
      </a>
    ))}
  </nav>
  <a
    href="/contact"
    class="mt-auto type-label text-center bg-ink text-ink-foreground py-4 transition-transform duration-150 active:scale-[0.98]"
  >
    Start a Project
  </a>
</div>

<style>
  #site-header {
    --nav-fg: var(--foreground);
    --nav-muted: var(--muted-foreground);
    --nav-border: color-mix(in srgb, var(--foreground) 20%, transparent);
  }
  #site-header[data-blend='true'][data-scrolled='false'] {
    --nav-fg: var(--background);
    --nav-muted: color-mix(in srgb, var(--background) 78%, transparent);
    --nav-border: color-mix(in srgb, var(--background) 35%, transparent);
  }

  .nav-link {
    color: var(--nav-muted);
  }
  .nav-link[data-active='true'] {
    color: var(--nav-fg);
  }
  .nav-link:hover {
    color: var(--nav-fg);
  }

  .nav-toggle {
    border-color: var(--nav-border);
  }
  .menu-bar {
    background-color: var(--nav-fg);
  }

  /* Logo crossfade — CSS-driven instead of a JS src-swap, so the mark
     never pops between colorways as the header blends on scroll. */
  .logo-white,
  .logo-dark {
    transition: opacity 500ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .logo-dark {
    opacity: 0;
  }
  #site-header[data-scrolled='true'] .logo-white {
    opacity: 0;
  }
  #site-header[data-scrolled='true'] .logo-dark {
    opacity: 1;
  }

  #nav-cta {
    transition:
      background-color 500ms cubic-bezier(0.4, 0, 0.2, 1),
      color 500ms cubic-bezier(0.4, 0, 0.2, 1),
      transform 200ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  #nav-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px -8px rgba(20, 18, 15, 0.35);
  }
  #nav-cta:active {
    transform: translateY(0);
    box-shadow: 0 2px 8px -4px rgba(20, 18, 15, 0.25);
  }

  #site-header[data-blend='true'][data-scrolled='false'] #nav-cta {
    background-color: var(--background);
    color: var(--ink);
  }
  #site-header[data-blend='true'][data-scrolled='false'] #nav-cta:hover {
    background-color: var(--accent-quiet);
  }

  /* Mobile menu links — the per-link stagger delay (set inline) needs an
     actual entrance transition to stagger, not just a hover color swap. */
  .mobile-nav-link {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 350ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 350ms cubic-bezier(0.16, 1, 0.3, 1),
      color 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  #mobile-menu:not(.translate-x-full) .mobile-nav-link {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const header = document.getElementById('site-header')!

  if (header.dataset.blend === 'true') {
    const setScrolled = (scrolled: boolean) => {
      const next = scrolled ? 'true' : 'false'
      if (header.dataset.scrolled === next) return
      header.dataset.scrolled = next
    }

    const threshold = () => Math.max(window.innerHeight - 140, 200)

    let ticking = false
    const onScroll = () => {
      if (ticking) return
      ticking = true
      requestAnimationFrame(() => {
        setScrolled(window.scrollY > threshold())
        ticking = false
      })
    }

    setScrolled(window.scrollY > threshold())
    window.addEventListener('scroll', onScroll, { passive: true })
    window.addEventListener('resize', onScroll)
  }

  const toggle = document.getElementById('menu-toggle')!
  const menu = document.getElementById('mobile-menu')!
  const bars = toggle.querySelectorAll('.menu-bar')

  let open = false

  function setOpen(next: boolean) {
    open = next
    menu.classList.toggle('translate-x-full', !open)
    toggle.setAttribute('aria-expanded', String(open))
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu')
    document.body.style.overflow = open ? 'hidden' : ''
    bars[0].classList.toggle('rotate-45', open)
    bars[0].classList.toggle('translate-y-[5px]', open)
    bars[1].classList.toggle('-rotate-45', open)
    bars[1].classList.toggle('-translate-y-[5px]', open)
  }

  toggle.addEventListener('click', () => setOpen(!open))
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)))
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && open) setOpen(false)
  })
</script>
