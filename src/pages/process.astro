---
import BaseLayout from '@/layouts/BaseLayout.astro'
import HeadlineReveal from '@/components/HeadlineReveal.astro'
import ProcessCutoutSections from '@/components/react/ProcessCutoutSections'
import { processStages } from '@/data/process'
---

<BaseLayout
  title="Process"
  description="From idea to finished piece — discover, develop, refine, produce, finish, deliver. The six stages behind every piece Hannah Pixels creates."
>
  <section class="pt-[140px] pb-14 md:pb-20 px-6 lg:px-10 max-w-[1440px] mx-auto">
    <div class="max-w-3xl">
      <div class="type-eyebrow text-accent mb-6">05 / The Process</div>
      <HeadlineReveal
        as="h1"
        class="type-section text-foreground"
        lines={['From Idea to', '*Finished Piece.*']}
      />
      <p class="text-base sm:text-lg text-muted-foreground leading-relaxed mt-8 max-w-xl">
        Craftsmanship is control. Each stage moves the work closer to its final form — from initial discovery and structural development to precision presswork, artisan finishes and worldwide delivery.
      </p>
    </div>

    <!-- Quick stage anchor navigation -->
    <div class="flex flex-wrap gap-x-8 gap-y-3 mt-12 pt-8 border-t border-grid">
      {processStages.map((s) => (
        <a
          href={`#${s.title.toLowerCase()}`}
          class="type-label text-muted-foreground hover:text-accent transition-colors flex items-center gap-2.5 group"
        >
          <span class="font-serif italic text-accent group-hover:underline">{s.num}</span>
          <span class="tracking-wide">{s.title}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Full-bleed Cutout Scroll Sections -->
  <ProcessCutoutSections client:visible stages={processStages} />

  <section class="bg-ink text-ink-foreground py-28 md:py-36 px-6 lg:px-10 text-center">
    <div class="max-w-2xl mx-auto space-y-8">
      <h2 class="type-section text-ink-foreground uppercase">Have a project<br /><span class="italic text-accent-quiet">in mind?</span></h2>
      <a href="/contact" class="btn-lift type-label inline-block bg-background text-ink px-7 py-3.5 hover:bg-accent-quiet">
        Start a Project
      </a>
    </div>
  </section>
</BaseLayout>
