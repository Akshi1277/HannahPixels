---
import BaseLayout from '@/layouts/BaseLayout.astro'
import MaskedLines from '@/components/react/MaskedLines'
import HeadlineReveal from '@/components/HeadlineReveal.astro'
import CatalogueReveal from '@/components/react/CatalogueReveal'
import ProcessTimeline from '@/components/react/ProcessTimeline'
import { capabilities } from '@/data/capabilities'
import { processStages, principles } from '@/data/process'
---

<BaseLayout
  title="Where Ideas Take Form"
  description="Hannah Pixels is a print and packaging house creating considered physical experiences for brands across the world — luxury packaging, fragrance and beauty, chocolate and confectionery, paper and carry, books and publishing."
>
  <!-- 01 — HERO -->
  <section class="relative min-h-[100svh] w-full overflow-hidden">
    <img
      src="/images/material-gold-leaf-texture.jpg"
      alt="Gold foil material detail"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-ink/40"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-ink/95 via-ink/60 to-ink/25"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-ink/55 via-ink/15 to-transparent"></div>

    <div class="relative z-10 h-full flex flex-col justify-between px-6 lg:px-10 pt-[100px] pb-12 lg:pb-16 [text-shadow:0_2px_20px_rgba(15,13,10,0.65)]">
      <div class="type-eyebrow text-background/70">Print &amp; Packaging House — Worldwide</div>

      <div class="max-w-4xl">
        <HeadlineReveal
          as="h1"
          class="type-hero text-background"
          accentClass="text-accent-quiet"
          lines={['WHERE', '*IDEAS*', 'TAKE FORM.']}
        />

        <div class="pt-8 max-w-xl space-y-4">
          <p class="text-lg text-background/90 leading-relaxed">
            Hannah Pixels is a print and packaging house creating considered physical experiences for brands across the world.
          </p>
          <p class="text-sm text-background/70 leading-relaxed">
            From luxury rigid boxes and fragrance packaging to bespoke paper bags, corrugated solutions, chocolate packaging and publishing, we bring together thoughtful design, exceptional materials and precise production.
          </p>
        </div>

        <div class="pt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
          <a
            href="/capabilities"
            class="type-label bg-background text-ink px-6 py-3.5 hover:bg-accent-quiet transition-colors"
          >
            Explore Our Capabilities
          </a>
          <a
            href="/contact"
            class="type-label text-background border-b border-background/50 hover:border-background pb-1 transition-colors"
          >
            Start a Project
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 — BRAND STATEMENT -->
  <section class="py-28 md:py-40 px-6 lg:px-10">
    <div class="max-w-4xl mx-auto text-center space-y-10">
      <MaskedLines
        client:visible
        mode="scroll"
        className="type-section text-foreground uppercase"
        lines={['DESIGNED WITH', '*INTENTION.*', 'MADE TO BE REMEMBERED.']}
      />
      <p class="font-serif text-2xl sm:text-3xl text-foreground/80 leading-snug max-w-xl mx-auto">
        Packaging is more than protection. It is the first touch. The first impression. The moment a brand becomes tangible.
      </p>
    </div>
  </section>

  <!-- 03 — WHAT WE CREATE -->
  <section class="pb-28 md:pb-40 px-6 md:px-12 lg:px-16">
    <div class="max-w-[1140px] mx-auto">
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-14 md:mb-20 border-b border-grid pb-8">
        <h2 class="type-section text-foreground">What We Create</h2>
        <p class="text-base sm:text-lg text-muted-foreground max-w-sm leading-relaxed">
          Print and packaging developed around the character, purpose and physical experience of your brand.
        </p>
      </div>

      <CatalogueReveal client:visible items={capabilities} />
    </div>
  </section>

  <!-- 04 — MATERIALITY -->
  <section class="bg-ink text-ink-foreground py-28 md:py-40">
    <div class="px-6 lg:px-10 max-w-[1440px] mx-auto mb-14 md:mb-20">
      <h2 class="type-section text-ink-foreground uppercase max-w-3xl">
        Materials <span class="italic text-accent-quiet">That Matter.</span>
      </h2>
      <p class="text-base sm:text-lg text-white/60 leading-relaxed max-w-md mt-6">
        The right material can transform how a product is seen, held and remembered.
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-1">
      <div class="col-span-2 md:col-span-2 aspect-[4/3] relative overflow-hidden">
        <img src="/images/material-copper-foil.jpg" alt="Crumpled copper foil detail" class="absolute inset-0 w-full h-full object-cover scale-125" loading="lazy" />
      </div>
      <div class="aspect-[4/3] relative overflow-hidden">
        <img src="/images/material-black-leather.jpg" alt="Black leather texture detail" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
      </div>
      <div class="aspect-[4/3] relative overflow-hidden">
        <img src="/images/material-speciality-papers.jpg" alt="Specialty paper texture detail" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
      </div>
      <div class="aspect-[4/3] relative overflow-hidden">
        <img src="/images/material-embossed-paper.jpg" alt="Embossed handmade paper detail" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
      </div>
      <div class="col-span-2 md:col-span-3 aspect-[16/7] relative overflow-hidden">
        <img src="/images/material-screen-print.jpg" alt="Screen printing process detail" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- 05 — THE PROCESS -->
  <section class="py-28 md:py-44 px-6 lg:px-10 border-b border-grid">
    <div class="max-w-[1440px] mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 mb-20 md:mb-28">
        <div class="md:col-span-6">
          <div class="type-eyebrow text-accent mb-6">05 / The Process</div>
          <h2 class="font-serif text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-light text-foreground leading-[0.95]">
            From Idea<br />
            to Finished<br />
            <span class="italic text-accent">Piece.</span>
          </h2>
        </div>
        <div class="md:col-span-5 md:col-start-8 md:pt-10 flex flex-col justify-between">
          <p class="text-base sm:text-lg text-muted-foreground font-light leading-relaxed max-w-md">
            Every project follows a considered sequence — from first conversation to finished delivery. Each stage is an opportunity to refine the detail.
          </p>
          <a
            href="/process"
            class="group mt-8 inline-flex items-center gap-2 type-label text-foreground border-b border-foreground/30 pb-1 hover:border-accent hover:text-accent transition-all duration-300 w-fit"
          >
            View Full Process
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-3.5 h-3.5 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform duration-300"
              aria-hidden="true"
            >
              <line x1="7" y1="17" x2="17" y2="7" />
              <polyline points="7 7 17 7 17 17" />
            </svg>
          </a>
        </div>
      </div>

      <ProcessTimeline client:visible stages={processStages} />
    </div>
  </section>

  <!-- 06 — THE HANNAH PIXELS STANDARD -->
  <section class="py-32 md:py-48 px-6 md:px-12 lg:px-16 bg-secondary/30 border-b border-grid">
    <div class="max-w-[1140px] mx-auto">
      <div class="type-eyebrow text-accent mb-12 md:mb-16">06 / The Hannah Pixels Standard</div>

      <h2 class="font-serif text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-light text-foreground leading-[0.95] mb-20 md:mb-32 max-w-4xl">
        The Hannah Pixels<br />
        <span class="italic text-accent">Standard.</span>
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-16 lg:gap-x-24 gap-y-16 md:gap-y-24">
        {principles.map((p, i) => (
          <div class:list={['flex gap-6', i % 2 === 1 && 'md:mt-24']}>
            <span class="font-serif italic text-base text-accent mt-1 flex-shrink-0">
              0{i + 1}
            </span>
            <div>
              <h3 class="font-serif text-2xl md:text-3xl lg:text-4xl font-light text-foreground mb-4 leading-tight">
                {p.title}
              </h3>
              <p class="text-base sm:text-lg text-muted-foreground font-light leading-relaxed max-w-md">
                {p.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 07 — WITHOUT BORDERS -->
  <section class="py-32 md:py-48 px-6 lg:px-10 relative overflow-hidden bg-background border-b border-grid">
    {/* Atmospheric Cartographic Background Image */}
    <img
      src="/images/world-borders-map.jpg"
      alt="Antique cartography map of world hemispheres"
      class="absolute inset-0 w-full h-full object-cover object-center opacity-[0.16] mix-blend-multiply pointer-events-none select-none filter contrast-125"
      loading="lazy"
    />

    {/* Subtle radial scrim so typography is crisp and legible */}
    <div class="absolute inset-0 bg-radial from-background/45 via-background/70 to-background/95 pointer-events-none"></div>

    {/* Subtle technical compass/coordinate lines over the map */}
    <svg
      aria-hidden="true"
      viewBox="0 0 800 400"
      class="absolute inset-0 w-full h-full opacity-[0.08] text-foreground pointer-events-none"
      fill="none"
    >
      <circle cx="400" cy="200" r="120" stroke="currentColor" stroke-width="0.5" />
      <circle cx="400" cy="200" r="190" stroke="currentColor" stroke-width="0.5" />
      <line x1="0" y1="200" x2="800" y2="200" stroke="currentColor" stroke-width="0.5" />
      <line x1="400" y1="0" x2="400" y2="400" stroke="currentColor" stroke-width="0.5" />
    </svg>

    <div class="max-w-2xl mx-auto text-center relative z-10">
      <h2 class="font-serif text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-light text-foreground uppercase tracking-tight leading-[0.95]">
        Without<br />
        <span class="italic text-accent font-normal">Borders.</span>
      </h2>
      <p class="text-base sm:text-lg text-muted-foreground font-light leading-relaxed mt-8 max-w-lg mx-auto">
        From a single bespoke project to larger production runs, Hannah Pixels works with brands across markets and delivers worldwide.
      </p>
    </div>
  </section>

  <!-- 08 — FINAL CTA -->
  <section class="bg-ink text-ink-foreground py-32 md:py-48 px-6 lg:px-10 text-center">
    <div class="max-w-3xl mx-auto space-y-10">
      <h2 class="type-section text-ink-foreground uppercase">
        Print That Speaks.<br /><span class="italic text-accent-quiet">Packaging That Stays.</span>
      </h2>
      <p class="text-base sm:text-lg text-white/60">Have a project in mind?</p>
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-4 pt-2">
        <a href="/contact" class="type-label bg-background text-ink px-7 py-3.5 hover:bg-accent-quiet transition-colors">
          Start a Project
        </a>
        <a href="/contact" class="type-label text-ink-foreground border-b border-white/40 hover:border-white pb-1 transition-colors">
          Get in Touch
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
